#!/bin/sh
# PID 1 inside the v86 VM: minimal system bring-up, then a console shell.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /dev/mqueue /tmp /dev/shm
mount -t mqueue mqueue /dev/mqueue
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /dev/shm
ifconfig lo 127.0.0.1 up
hostname spacey-sat1
echo "VM-READY $(cat /proc/uptime)"
# serial bridge: browser <-> cFS UDP (ttyS1 is the data channel, ttyS0 is the console)
/bin/serbridge /dev/ttyS1 2>/tmp/serbridge.log &
# diagnostic port: physical memory map on request (exits quietly if ttyS3 is absent)
rm -f /tmp/tmr_regions
# COM4 fails Linux's loopback self-test under v86 and is left "unknown"; declare it a 16550A
setserial /dev/ttyS3 uart 16550A 2>/dev/null
/bin/memmap /dev/ttyS3 2>/tmp/memmap.log &
# Flight computer mode: boot straight into the flight software (used by the demo page,
# so a hardware watchdog reset brings cFS back with no one at the keyboard)
if grep -q 'fsw=auto' /proc/cmdline; then
  echo "FSW-AUTOSTART"
  # show startup milestones and any failure (a corrupted file shows up here), plus the exit code
  (cd /cfs/cpu1 && { ./core-cpu1 2>&1; echo "FSW-EXIT $?"; } | tee /tmp/cfs.log | grep -E 'OPERATIONA[L]|RESET due t[o]|Could not loa[d]|Could not fin[d]|ERRO[R]|[Ff]ailed t[o]|FSW-EXI[T]|not foun[d]|[Ee]xec forma[t]|syntax erro[r]') &
fi
exec setsid cttyhack /bin/sh
