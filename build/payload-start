#!/bin/sh
# Run a payload command the ground sent (serbridge, on "GS<command line>"): from the SD card's
# data partition, with it on the PATH. $1: the whole command line.
[ -d /sd ] && mountpoint -q /sd || { echo "the SD card's data partition is not mounted"; exit 2; }
cd /sd && export PATH=/sd:$PATH && exec sh -c "exec $1"
